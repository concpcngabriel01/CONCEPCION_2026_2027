{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Django: runserver",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["manage.py", "runserver"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Watching for file changes",
          "endsPattern": "Starting development server at"
        }
      }
    },
    {
      "label": "React: Vite dev server",
      "type": "npm",
      "script": "dev",
      "path": "frontend/",
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:\\s+http://localhost:\\d+/"
        }
      }
    },
    {
      "label": "Start full stack",
      "dependsOn": ["Django: runserver", "React: Vite dev server"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "React: production build",
      "type": "npm",
      "script": "build",
      "path": "frontend/",
      "problemMatcher": []
    }
  ]
}
